[Unit]
Description=lohrer.dev contact relay (Kontaktformular -> Mailserver-API)
After=network.target

[Service]
ExecStart=/usr/bin/node /opt/lohrer.dev/contact-relay.mjs
# MAIL_API_TOKEN und CONTACT_TO stehen in /etc/contact-relay.env (chmod 600)
EnvironmentFile=/etc/contact-relay.env
Environment=MAIL_API_URL=http://127.0.0.1:3080/v1/send
Restart=on-failure
RestartSec=3
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
